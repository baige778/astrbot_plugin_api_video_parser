{
  "parser_api_base_url": {
    "type": "string",
    "description": "解析接口地址",
    "default": "http://192.168.5.116:8000"
  },
  "video_max_size_mb": {
    "type": "int",
    "description": "最大视频大小限制 (MB)",
    "default": 50
  },
  "request_timeout_ms": {
    "type": "int",
    "description": "请求超时时间 (毫秒)",
    "default": 15000
  },
  "send_cover": {
    "type": "bool",
    "description": "发送视频封面图",
    "default": true
  },
  "send_processing_message": {
    "type": "bool",
    "description": "发送处理中提示",
    "default": true
  },
  "processing_message": {
    "type": "string",
    "description": "处理中提示语",
    "collapsed": true,
    "default": "ikun解析bot正在处理中。。。"
  },
  "send_video_deleted_message": {
    "type": "bool",
    "description": "发送视频已删除提示",
    "default": true
  },
  "video_deleted_message": {
    "type": "string",
    "description": "视频已删除提示语",
    "collapsed": true,
    "default": "该视频已被邪恶势力处理！！！"
  },
  "video_sending_message": {
    "type": "string",
    "description": "视频发送中提示语",
    "collapsed": true,
    "default": "视频解析成功，正在发送视频..."
  },
  "send_video_sending_message": {
    "type": "bool",
    "description": "发送视频发送中提示",
    "default": true
  },
  "send_empty_result_message": {
    "type": "bool",
    "description": "发送空结果提示",
    "default": true
  },
  "empty_result_message": {
    "type": "string",
    "description": "空结果提示语",
    "collapsed": true,
    "default": "解析成功，但链接内容好像既不是视频也不是图集呢"
  },
  "send_parse_fail_message": {
    "type": "bool",
    "description": "发送解析失败提示",
    "default": true
  },
  "parse_fail_message": {
    "type": "string",
    "description": "解析失败提示语（{error}=错误信息）",
    "collapsed": true,
    "default": "解析失败：{error}"
  },
  "send_size_fail_message": {
    "type": "bool",
    "description": "发送视频大小获取失败提示",
    "default": true
  },
  "size_fail_message": {
    "type": "string",
    "description": "视频大小获取失败提示语",
    "collapsed": true,
    "default": "获取视频大小失败，无法直接发送，请尝试点击源链接观看。"
  },
  "send_size_exceeded_message": {
    "type": "bool",
    "description": "发送视频大小超限提示",
    "default": true
  },
  "size_exceeded_message": {
    "type": "string",
    "description": "视频大小超限提示语（{file_size}/{max_size}）",
    "collapsed": true,
    "default": "视频大小为 {file_size}MB，超过 {max_size}MB 限制，请尝试点击源链接观看。"
  },
  "send_download_fail_message": {
    "type": "bool",
    "description": "发送视频下载失败提示",
    "default": true
  },
