{
  "parser_api_base_url": {
    "type": "string",
    "description": "解析接口地址",
    "hint": "用于请求视频解析服务的基础地址。",
    "default": "http://192.168.5.116:8000"
  },
  "video_max_size_mb": {
    "type": "int",
    "description": "最大视频大小限制 (MB)",
    "hint": "超过此大小的视频将不会直接发送。",
    "default": 50
  },
  "request_timeout_ms": {
    "type": "int",
    "description": "请求超时时间 (毫秒)",
    "hint": "API请求和文件探测的超时时间。",
    "default": 15000
  },
  "send_cover": {
    "type": "bool",
    "description": "发送视频封面图",
    "hint": "是否在发送视频的同时附带封面图片。",
    "default": true
  },
  "send_processing_message": {
    "type": "bool",
    "description": "发送处理中提示",
    "hint": "是否在解析视频前发送处理中提示语。",
    "default": true
  },
  "processing_message": {
    "type": "string",
    "description": "处理中提示语",
    "hint": "解析视频前发送的提示文字，内容可自定义。是否发送由「发送处理中提示」开关控制。",
    "default": "ikun解析bot正在处理中。。。"
  },
  "send_video_deleted_message": {
    "type": "bool",
    "description": "发送视频已删除提示",
    "hint": "是否在视频已被删除/下架时发送提示语。",
    "default": true
  },
  "video_deleted_message": {
    "type": "string",
    "description": "视频已删除提示语",
    "hint": "当解析的视频已被删除/下架时发送的提示文字，内容可自定义。是否发送由「发送视频已删除提示」开关控制。",
    "default": "该视频已被邪恶势力处理！！！"
  },
  "douyin_login_poll_timeout": {
    "type": "int",
    "description": "抖音登录轮询超时 (秒)",
    "hint": "扫码登录后后台检测登录状态的超时时间，需与后端 DOUYIN_LOGIN_TIMEOUT 保持一致。",
    "default": 300
  },
  "douyin_login_poll_interval": {
    "type": "int",
    "description": "抖音登录轮询间隔 (秒)",
    "hint": "后台检测登录状态的间隔，不建议过小以免频繁请求后端。",
    "default": 3
  },
  "platform_douyin": {
    "type": "bool",
    "description": "抖音",
    "hint": "是否开启抖音视频/图集解析。",
    "default": true
  },
